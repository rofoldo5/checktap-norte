+class TaskRecurrence {
+  const TaskRecurrence({
+    this.type = 'NONE',
+    this.interval = 1,
+    this.unit,
+    this.startAt,
+    this.timezone = 'UTC',
+    this.nextOccurrenceAt,
+    this.notificationsEnabled = false,
