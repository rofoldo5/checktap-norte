# Server and published API
SERVER_IP=192.168.30.51
API_BIND_ADDRESS=0.0.0.0
API_PORT=8080
API_BASE_URL=http://192.168.30.51:8080

# Backend image built on the Portainer Docker host
CHECKTAP_IMAGE=checktap-backend
CHECKTAP_IMAGE_TAG=0.7.0

# PostgreSQL. Use only letters and numbers in POSTGRES_PASSWORD because it is
# interpolated into DATABASE_URL by Compose.
POSTGRES_DB=checktap
POSTGRES_USER=checktap
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Authentication
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=480

# Initial administrator. It is created only when the email does not exist.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@checktap.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# Mobile clients do not require CORS, but keep this configurable for future web use.
CORS_ORIGINS=*

# Change this to the business timezone used by daily reports.
REPORT_TIMEZONE=America/Montreal
